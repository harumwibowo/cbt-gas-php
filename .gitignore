# Sementara / hasil debug
_tmp/
*.log
*.tmp
*.bak

# Artefak analisis (hasil ekstraksi sementara)
_analysis/

# Suite uji pengembangan (ikut di-Track agar CI dapat menjalankannya).
# Artefak Python di dalamnya tidak perlu di-commit.
__pycache__/
*.pyc

# Kunci enkripsi lokal (dibuat otomatis) — JANGAN di-commit
config/pass.key

# Kredensial database hasil halaman setup + penanda instalasi — JANGAN di-commit
config/database.json
config/installed.json
config/update_token.txt

# Cadangan berkas sebelum pembaruan aplikasi
/storage/

# Berkas sistem
.DS_Store
Thumbs.db
desktop.ini

# Editor
.idea/
.vscode/
*.swp
